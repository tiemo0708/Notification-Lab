    {
      "id": 6,
      "title": "Consumer lag (역할별 최대)",
      "description": "요청+Retry의 end−committed 합계. DLQ 제외. 같은 그룹을 보는 replica를 합산하지 않습니다. Offset이 없는 신규 파티션의 시작 가정은 별도 확인해야 합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nl-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
